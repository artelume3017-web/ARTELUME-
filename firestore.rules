rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Studio Invite Codes for Team Onboarding
    match /invites/{inviteCode} {
      allow read, write: if isAuthenticated();
    }

    // Public Client Shared Proposals (Read-only for clients, created by authenticated users or studios)
    match /sharedProposals/{proposalId} {
      allow read, write: if true;
    }

    // Company Documents & Subcollections (Accessible to all authenticated team members without role roadblocks)
    match /companies/{companyId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
